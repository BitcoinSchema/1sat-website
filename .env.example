# Canonical public 1Sat infrastructure
NEXT_PUBLIC_ONESAT_STACK_URL=https://api.1sat.app
# Unverified placeholder; public testnet routing is tracked in OPL-3992.
NEXT_PUBLIC_ONESAT_TEST_STACK_URL=https://testnet.api.1sat.app
NEXT_PUBLIC_WALLET_STORAGE_URL=https://wallet.1sat.app
NEXT_PUBLIC_APP_URL=http://localhost:8255

# Create a Convex deployment for CWI redirect handoffs.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Server-only. Use different long random values for preview and production.
CWI_REDIRECT_SECRET=replace-with-a-random-secret

# Sigma Identity OAuth (consumer). Register the redirect URI
# {NEXT_PUBLIC_APP_URL}/auth/sigma/callback on the Sigma client.
NEXT_PUBLIC_SIGMA_AUTH_URL=https://auth.sigmaidentity.com
NEXT_PUBLIC_SIGMA_CLIENT_ID=your-sigma-oauth-client-id
# Server-only WIF. Rename Vercel SIGMA_MEMBER_PRIVATE_KEY → SIGMA_ACCOUNT_PRIVATE_KEY
# (same value). No MEMBER fallback or alias.
SIGMA_ACCOUNT_PRIVATE_KEY=replace-with-account-wif
